<div class="page-header">
  <h1>Cours</h1>
  <a class="btn btn-primary" href="/app/courses/new">+ Ajouter un cours</a>
</div>

{{#if courses.length}}
<table class="data-table">
  <thead>
    <tr><th>Nom</th><th>Code</th><th>Crédits</th><th>Actions</th></tr>
  </thead>
  <tbody>
    {{#each courses}}
    <tr>
      <td><a href="/app/courses/{{id}}">{{name}}</a></td>
      <td>{{code}}</td>
      <td>{{credits}}</td>
      <td class="row-actions">
        <a class="btn btn-sm" href="/app/courses/{{id}}">Voir</a>
        <a class="btn btn-sm" href="/app/courses/{{id}}/edit">Modifier</a>
        <form method="POST" action="/app/courses/{{id}}/delete" onsubmit="return confirm('Supprimer ce cours ?');">
          <button class="btn btn-sm btn-danger" type="submit">Supprimer</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

<div class="pagination">
  {{#if hasPrev}}<a href="/app/courses?page={{prevPage}}">&laquo; Précédent</a>{{/if}}
  <span>Page {{currentPage}} / {{totalPages}}</span>
  {{#if hasNext}}<a href="/app/courses?page={{nextPage}}">Suivant &raquo;</a>{{/if}}
</div>
{{else}}
  <p class="muted">Aucun cours trouvé.</p>
{{/if}}
