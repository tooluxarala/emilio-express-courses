<div class="page-header">
  <h1>Inscriptions</h1>
  <a class="btn btn-primary" href="/app/subscriptions/new">+ Nouvelle inscription</a>
</div>

{{#if subscriptions.length}}
<table class="data-table">
  <thead>
    <tr><th>Étudiant</th><th>Cours</th><th>Date d'inscription</th><th>Actions</th></tr>
  </thead>
  <tbody>
    {{#each subscriptions}}
    <tr>
      <td><a href="/app/students/{{student.id}}">{{student.name}}</a></td>
      <td><a href="/app/courses/{{course.id}}">{{course.name}}</a></td>
      <td>{{formatDate subscribed_at}}</td>
      <td class="row-actions">
        <form method="POST" action="/app/subscriptions/{{id}}/delete" onsubmit="return confirm('Annuler cette inscription ?');">
          <button class="btn btn-sm btn-danger" type="submit">Désinscrire</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

<div class="pagination">
  {{#if hasPrev}}<a href="/app/subscriptions?page={{prevPage}}">&laquo; Précédent</a>{{/if}}
  <span>Page {{currentPage}} / {{totalPages}}</span>
  {{#if hasNext}}<a href="/app/subscriptions?page={{nextPage}}">Suivant &raquo;</a>{{/if}}
</div>
{{else}}
  <p class="muted">Aucune inscription trouvée.</p>
{{/if}}
